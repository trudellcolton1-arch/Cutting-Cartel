# ===== Database =====
DATABASE_URL="postgresql://USER:PASS@localhost:5432/cutline?schema=public"

# ===== NextAuth =====
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# ===== Google OAuth (optional) =====
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ===== Email (booking confirmations + magic-link sign-in) =====
# Resend recommended: smtp.resend.com / port 465 / user "resend" / pass = your API key
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="24/7 Cuts <bookings@247cuts.com>"
# Optional: comma-separated list of recipients for new-booking emails.
# Overrides the barber's own user.email — useful for sending to Brian's
# personal inbox without touching the database.
BARBER_NOTIFICATION_EMAILS="teflonboogie@gmail.com"

# ===== Stripe =====
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ===== Cloudinary (selfie + AI preview storage) =====
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
# Unsigned upload preset name — Cloudinary dashboard → Settings → Upload → Upload presets
# → Add → Signing Mode: Unsigned. Lets the browser upload selfies directly to Cloudinary
# (1-3s instead of 10-15s). Without this, uploads fall back to the slower server route.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="cutline-unsigned"

# ===== Cutline AI (Replicate · FLUX.1 + PuLID) =====
REPLICATE_API_TOKEN=""
# optional: pin a different model SHA (override the default in src/lib/replicate.ts)
REPLICATE_MODEL_VERSION=""

# ===== App =====
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="24/7 Cuts"
