// Cutline AI — The Cutting Cartel
// Prisma schema for users, barbers, hairstyles, try-on sessions, appointments, and payments.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== NextAuth models =====

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ===== Domain models =====

enum UserRole {
  CUSTOMER
  BARBER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  role          UserRole  @default(CUSTOMER)
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  appointments  Appointment[]    @relation("CustomerAppointments")
  tryOnSessions TryOnSession[]
  barberProfile Barber?
}

model Barber {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  bio         String?
  shopName    String   @default("The Cutting Cartel")
  city        String   @default("Dallas, TX")
  avatarUrl   String?
  // base price retained for back-compat; new bookings use the per-cut prices below
  basePriceCents Int   @default(6000)
  priceAdultCents Int  @default(6000)  // $60 default
  priceKidCents   Int  @default(2000)  // $20 default
  // 30-min slots, expressed as a JSON map of weekday -> [start, end] in 24h "HH:mm"
  workingHours   Json  @default("{\"mon\":[\"10:00\",\"19:00\"],\"tue\":[\"10:00\",\"19:00\"],\"wed\":[\"10:00\",\"19:00\"],\"thu\":[\"10:00\",\"19:00\"],\"fri\":[\"10:00\",\"20:00\"],\"sat\":[\"09:00\",\"18:00\"],\"sun\":null}")
  slotMinutes    Int   @default(45)
  isActive       Boolean @default(true)
  // when set, no slots show before this date (vacation / time-off blocking)
  availableFrom  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]  @relation("BarberAppointments")
}

model Hairstyle {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String   // fade, taper, textured, classic, design
  description String?
  // descriptive fragment fed to FLUX+PuLID, e.g. "low fade with textured top"
  prompt      String   @default("a fresh haircut")
  thumbnailUrl String
  defaultLength    Int   @default(3)     // 1..5
  defaultFade      Int   @default(2)     // 0..5 (0 = none, 5 = skin)
  isActive         Boolean @default(true)
  createdAt        DateTime @default(now())

  tryOnSessions TryOnSession[]
  appointments  Appointment[]
}

model TryOnSession {
  id           String   @id @default(cuid())
  userId       String?
  hairstyleId  String
  // input selfie (Cloudinary URL)
  selfieUrl    String
  // composited preview after AI overlay (Cloudinary URL)
  previewUrl   String?
  length       Int      @default(3)
  fade         Int      @default(2)
  notes        String?
  createdAt    DateTime @default(now())

  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  hairstyle    Hairstyle   @relation(fields: [hairstyleId], references: [id])
  appointment  Appointment?

  @@index([userId])
}

enum AppointmentStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id              String   @id @default(cuid())
  customerId      String
  barberId        String
  hairstyleId     String?
  tryOnSessionId  String?  @unique
  startsAt        DateTime
  endsAt          DateTime
  status          AppointmentStatus @default(PENDING_PAYMENT)
  notes           String?
  priceCents      Int
  cutType         String   @default("adult")    // "adult" or "kid"
  paymentMethod   String   @default("online")   // "online" (Stripe) or "in_person"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer       User           @relation("CustomerAppointments", fields: [customerId], references: [id])
  barber         Barber         @relation("BarberAppointments", fields: [barberId], references: [id])
  hairstyle      Hairstyle?     @relation(fields: [hairstyleId], references: [id])
  tryOnSession   TryOnSession?  @relation(fields: [tryOnSessionId], references: [id])
  payment        Payment?

  // Prevent two confirmed appointments on the same barber at the same start time.
  @@unique([barberId, startsAt])
  @@index([customerId])
  @@index([startsAt])
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id                    String   @id @default(cuid())
  appointmentId         String   @unique
  stripePaymentIntentId String   @unique
  stripeCheckoutId      String?  @unique
  amountCents           Int
  currency              String   @default("usd")
  status                PaymentStatus @default(REQUIRES_PAYMENT)
  receiptUrl            String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}
